Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/RobotModel
      Description Topic: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: StaticMap
      Topic: /map
      Update Strategy: Update Once
    - Class: rviz_default_plugins/LaserScan
      [cite_start]Topic: /scan # Nutzt den effizienten 2D-Scan 
      Enabled: true
      Name: LaserScan
      Size (m): 0.03
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/PointCloud2
      [cite_start]Topic: /camera/depth/points # Die 3D-Daten 
      Enabled: false # STANDARDMÄSSIG AUSGESCHALTET für CPU-Schonung
      Name: PointCloud_3D
      Selectable: false
      Style: Pixels # Wenn eingeschaltet, dann als effiziente Pixel
      Decimation: 4 # Zeigt nur jeden 4. Punkt an
    - Class: rviz_default_plugins/Path
      Topic: /plan
      Enabled: true
      Name: GlobalPath
      Color: 0; 255; 0
    - Class: rviz_default_plugins/Path
      Topic: /local_plan
      Enabled: true
      Name: LocalPlan
      Color: 0; 0; 255

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map # Wichtig für die Navigation
    Frame Rate: 10 # Begrenzt die Rviz-interne Render-Rate

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Name: Current View
      Pitch: 0.7
      Yaw: 0.7
